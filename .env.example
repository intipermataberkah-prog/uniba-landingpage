# Copy to .env.local for local dev, and set the same keys in
# Vercel → Project Settings → Environment Variables for production.
#
# Every key here is optional. The features they drive render nothing when unset,
# so dev and preview builds stay out of production analytics.

# Google Tag Manager container, e.g. GTM-XXXXXXX.
# The Google Ads conversion tag lives INSIDE this container rather than in the
# codebase, so conversion IDs/labels change without a redeploy — and so the Ads
# tag fires in real time instead of arriving 24-48h late via a GA4 import.
NEXT_PUBLIC_GTM_ID=

# Google Search Console HTML-tag verification token (the content="..." value only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Canonical production origin. Vercel supplies VERCEL_PROJECT_PRODUCTION_URL
# automatically; set this only to override it with the custom domain.
NEXT_PUBLIC_SITE_URL=
